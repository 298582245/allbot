  "components": {
    "securitySchemes": {
      "BearerAppToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "AllBot application token"
      },
      "MCPAppBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "仅 MCP 入口支持，用户名为管理后台展示的 appKey，密码为 appSecret"
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 20
        },
        "description": "每页记录数，默认 20，最大 200。"
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "description": "分页偏移量，从 0 开始。"
      }
    },
    "schemas": {
      "MCPRequest": {
        "type": "object",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": [
              "2.0"
            ],
            "description": "JSON-RPC 版本。"
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "本次请求的关联 ID；通知消息可省略。"
          },
          "method": {
            "type": "string",
            "description": "JSON-RPC 方法，如 initialize、tools/list 或 tools/call。"
          },
          "params": {
            "type": "object",
            "description": "MCP 方法参数；tools/call 中包含 name 与 arguments。",
            "properties": {
              "name": {
                "type": "string",
                "description": "tools/call 要调用的工具名。"
              },
              "arguments": {
                "type": "object",
                "description": "工具参数；API 工具包含 method、path、query、body 或 raw_body_base64、content_type。",
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "SettingsUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "auto_refresh": {
            "type": "boolean",
            "description": "是否启用面板自动刷新。"
          },
          "refresh_interval": {
            "type": "integer",
            "description": "面板自动刷新间隔（分钟）。"
          },
          "auto_load_plugins": {
            "type": "boolean",
            "description": "启动时是否自动加载插件。"
          },
          "script_task_concurrent_limit": {
            "type": "integer",
            "description": "脚本任务并发上限。"
          },
          "points_unit": {
            "type": "string",
            "description": "积分单位名称。"
          }
        }
      },
      "PluginCreateRequest": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "runtime",
          "trigger",
          "platforms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "插件唯一 ID。"
          },
          "name": {
            "type": "string",
            "description": "插件显示名称。"
          },
          "version": {
            "type": "string",
            "description": "插件版本。"
          },
          "runtime": {
            "type": "string",
            "description": "运行时类型，如 nodejs 或 python。"
          },
          "runtime_profile": {
            "type": "string",
            "description": "绑定的运行环境 Profile ID。"
          },
          "trigger": {
            "type": "string",
            "description": "插件触发规则。"
          },
          "priority": {
            "type": "integer",
            "description": "插件匹配优先级。"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "插件支持的平台标识列表。"
          },
          "enabled": {
            "type": "boolean",
            "description": "是否启用插件。"
          },
          "user_config_schema": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "用户配置字段定义。"
          },
          "user_config": {
            "type": "object",
            "additionalProperties": true,
            "description": "插件配置值。"
          },
          "script_env": {
            "type": "object",
            "additionalProperties": true,
            "description": "脚本运行环境配置。"
          },
          "template": {
            "type": "string",
            "description": "创建插件时选择的模板 ID。"
          },
          "account_ql": {
            "type": "object",
            "additionalProperties": true,
            "description": "AccountQL 模板配置，仅对应模板类型使用。"
          }
        }
      },
      "AdapterConfig": {
        "type": "object",
        "required": [
          "platform"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "适配器 ID；创建时为 0 或省略。"
          },
          "platform": {
            "type": "string",
            "description": "平台适配器标识。"
          },
          "remark": {
            "type": "string",
            "description": "管理员备注。"
          },
          "description": {
            "type": "string",
            "description": "适配器说明。"
          },
          "enabled": {
            "type": "boolean",
            "description": "是否启用。"
          },
          "config": {
            "type": "object",
            "additionalProperties": true,
            "description": "平台适配器配置；字段根据 platform 而异。"
          }
        }
      },
      "AdapterAction": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "pin",
              "unpin"
            ],
            "description": "置顶或取消置顶适配器。"
          }
        }
      },
      "ActionRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "插件操作名称；合法值由插件管理 Handler 定义。"
          }
        }
      },
      "UserStatusUpdate": {
        "type": "object",
        "required": [
          "disabled"
        ],
        "additionalProperties": false,
        "properties": {
          "disabled": {
            "type": "boolean",
            "description": "true 表示禁用用户，false 表示恢复用户。"
          }
        }
      },
      "UserPointsAdjustment": {
        "type": "object",
        "required": [
          "delta"
        ],
        "additionalProperties": false,
        "properties": {
          "delta": {
            "type": "integer",
            "format": "int64",
            "minimum": -999999999,
            "maximum": 999999999,
            "not": {
              "enum": [
                0
              ]
            },
            "description": "积分变更量；非零，正数增加、负数扣减。"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "本次积分调整说明，最多 500 个字符。"
          }
        }
      },
      "KeywordReply": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "关键字回复 ID；更新时使用。"
          },
          "keyword": {
            "type": "string",
            "description": "触发关键字。"
          },
          "match_type": {
            "type": "string",
            "description": "匹配方式。"
          },
          "reply_type": {
            "type": "string",
            "description": "回复内容类型。"
          },
          "content": {
            "type": "string",
            "description": "回复内容。"
          },
          "enabled": {
            "type": "boolean",
            "description": "是否启用。"
          },
          "admin_only": {
            "type": "boolean",
            "description": "是否仅管理员可触发。"
          },
          "pinned": {
            "type": "boolean",
            "description": "是否置顶。"
          },
          "schedule_enabled": {
            "type": "boolean",
            "description": "是否启用定时发送。"
          },
          "schedule_cron": {
            "type": "string",
            "description": "定时发送 Cron 表达式。"
          },
          "description": {
            "type": "string",
            "description": "管理员备注。"
          }
        }
      },
      "ScheduledTask": {
        "type": "object",
        "required": [
          "name",
          "cron",
          "platform",
          "content"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "任务 ID；更新时使用。"
          },
          "plugin_id": {
            "type": "string",
            "description": "关联插件 ID；可留空。"
          },
          "task_key": {
            "type": "string",
            "description": "插件内任务键。"
          },
          "name": {
            "type": "string",
            "description": "任务名称。"
          },
          "description": {
            "type": "string",
            "description": "任务说明。"
          },
          "enabled": {
            "type": "boolean",
            "description": "是否启用排程。"
          },
          "pinned": {
            "type": "boolean",
            "description": "是否置顶。"
          },
          "cron": {
            "type": "string",
            "description": "标准 Cron 表达式；一次性执行可使用 Handler 支持的一次性格式。"
          },
          "platform": {
            "type": "string",
            "description": "目标平台标识。"
          },
          "adapter_id": {
            "type": "string",
            "description": "目标适配器 ID。"
          },
          "user_id": {
            "type": "string",
            "description": "目标用户 ID。"
          },
          "group_id": {
            "type": "string",
            "description": "目标群组 ID；私聊场景可留空。"
          },
          "content": {
            "type": "string",
            "description": "要发送的消息内容。"
          },
          "source": {
            "type": "string",
            "description": "任务来源标识。"
          }
        }
      },
      "DataRowValues": {
        "type": "object",
        "required": [
          "values"
        ],
        "properties": {
          "values": {
            "type": "object",
            "additionalProperties": true,
            "description": "数据列名到值的映射。"
          }
        }
      },
      "PaymentSettings": {
        "type": "object",
        "description": "支付配置；敏感密钥在返回值中可能只提供是否已配置的标记。",
        "properties": {
          "points_per_rmb": {
            "type": "integer",
            "format": "int64",
