{
  "openapi": "3.0.3",
  "info": {
    "title": "AllBot 开发者 API 与 MCP",
    "version": "1.0.0",
    "description": "应用管理与使用说明见 docs/developer_api_mcp_usage.md。REST 业务接口使用 /api/v1 前缀并复用后台业务路径。应用按业务模块授权，授权后可调用该模块下所有已开放接口。"
  },
  "servers": [
    {
      "url": "{panelOrigin}",
      "variables": {
        "panelOrigin": {
          "default": "https://allbot.example.com"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "认证"
    },
    {
      "name": "能力目录"
    },
    {
      "name": "MCP"
    },
    {
      "name": "系统"
    },
    {
      "name": "设置"
    },
    {
      "name": "插件"
    },
    {
      "name": "适配器"
    },
    {
      "name": "用户"
    },
    {
      "name": "关键字回复"
    },
    {
      "name": "任务"
    },
    {
      "name": "支付"
    },
    {
      "name": "图床"
    },
    {
      "name": "日志"
    },
    {
      "name": "备份"
    },
    {
      "name": "数据"
    },
    {
      "name": "统计"
    },
    {
      "name": "SDK"
    }
  ],
  "paths": {
    "/api/v1/open-api/token": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "使用应用凭据换取 24 小时令牌",
        "security": [],
        "requestBody": {
          "required": true,
          "description": "请求字段使用 snake_case；其值对应管理后台展示的 appKey 与 appSecret。",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "app_key",
                  "app_secret"
                ],
                "properties": {
                  "app_key": {
                    "type": "string",
                    "description": "开发者应用的 appKey"
                  },
                  "app_secret": {
                    "type": "string",
                    "writeOnly": true,
                    "description": "开发者应用的 appSecret；创建或重置时仅展示一次"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "签发成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in"
                  ],
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "example": "Bearer"
                    },
                    "expires_in": {
                      "type": "integer",
                      "example": 86400
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthError"
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "tags": [
          "能力目录"
        ],
        "summary": "获取当前应用获授权的能力",
        "security": [
          {
            "BearerAppToken": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/JSONSuccess"
          },
          "401": {
            "$ref": "#/components/responses/AuthError"
          }
        }
      }
    },
    "/api/v1/mcp": {
      "post": {
        "tags": [
          "MCP"
        ],
        "summary": "MCP Streamable HTTP JSON-RPC 入口",
        "description": "支持 Basic base64(appKey:appSecret)、应用 Bearer 令牌及面板登录 Bearer 令牌。工具包括 list_capabilities，以及按已授权模块提供的 api_<resource>_<action> 工具。每次调用都检查工具声明与路径映射是否一致；文件类请求使用 raw_body_base64 和 content_type，二进制响应采用 base64 JSON 文本。",
        "security": [
          {
            "BearerAppToken": []
          },
          {
            "MCPAppBasic": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Streamable HTTP JSON-RPC 请求。initialize、tools/list 和 tools/call 使用 JSON-RPC 2.0 格式。",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MCPRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON-RPC 响应或 Streamable HTTP 响应"
          },
          "401": {
            "$ref": "#/components/responses/AuthError"
          }
        }
      }
    },
